# ── قاعدة البيانات ─────────────────────────────────────────
# التطوير المحلي يستخدم PostgreSQL مدمجة على المنفذ 5433 (شغّل: npm run db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bawsalati?schema=public"

# ── الجلسات ────────────────────────────────────────────────
# غيّرها في الإنتاج. تُوقّع بها كوكي الجلسة.
JWT_SECRET="" # openssl rand -hex 32

# ── التخزين ────────────────────────────────────────────────
# مجلد الملفات الخاصة — خارج public/ عمداً حتى لا يُقدَّم مباشرة
STORAGE_DIR="./storage"

# ── مزوّد الإشعارات ────────────────────────────────────────
# console = يسجّل الإشعار محلياً بدل إرساله. الإنتاج: whatsapp | sms
NOTIFY_PROVIDER="console"
NOTIFY_API_URL=""
NOTIFY_API_TOKEN=""
NOTIFY_SENDER_ID=""

# ── الشبكة ─────────────────────────────────────────────────
# عدد الوسطاء الموثوقين أمام التطبيق. يحدّد كيف يُقرأ عنوان العميل من
# X-Forwarded-For، وعليه يقوم تحديد المعدّل. 0 = لا وسيط (تشغيل محلي).
# خلف موازن حِمل واحد (Render وأمثاله) اضبطها على 1.
TRUSTED_PROXY_HOPS="0"

# ── التطبيق ────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
