# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# القالب بلا أسرار — يُرفع عمداً
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ملفات المكتبة ودليل الطالب — خارج المجلد العام عمداً
/storage

# عنقود PostgreSQL المحلي
/.pgdata

# رفعة تجريبية قديمة — التخزين الفعلي خارج public/
/public/uploads

# مخلّفات بايثون من سكربتات التحويل والتدقيق
__pycache__/
*.pyc
